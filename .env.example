# cp .env.example .env 후 실제 값을 입력하세요. .env는 절대 Git에 올리지 않습니다.

# ── Cloudflare Worker ───────────────────────────────
# Cloudflare Dashboard > My Profile > API Tokens에서 Workers Scripts:Edit 권한 토큰 생성
CLOUDFLARE_API_TOKEN=
# Cloudflare Dashboard > Workers & Pages > Overview에서 확인
CLOUDFLARE_ACCOUNT_ID=

# 이미 생성한 Worker 주소. 프론트엔드/API/OAuth가 모두 이 Origin을 사용합니다.
APP_BASE_URL=https://family-album.nhacker7k.workers.dev
FRONTEND_URL=https://family-album.nhacker7k.workers.dev
FRONTEND_ORIGIN=https://family-album.nhacker7k.workers.dev

# ── 구글 포토 (Google Cloud Console > OAuth 클라이언트 ID: 웹 애플리케이션) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# refresh token 암호화 키: openssl rand -base64 32
GOOGLE_TOKEN_KEY=

# ── 콘텐츠 검색 (TMDB API Settings에서 API Key (v3 auth) 발급) ──
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=

# ── 보안 ────────────────────────────────────────────
# 첫 가족 관리자 계정을 만든 뒤 false로 변경하고 서버를 재시작하세요.
ALLOW_NEW_FAMILY=true

# ── 월드컵 인터넷 이미지 검색 (선택) ─────────────────
PEXELS_API_KEY=
