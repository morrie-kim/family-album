# cp .env.example .env 후 값 채우기 (.env 는 git 에 올리지 않음)

# ── ngrok ───────────────────────────────────────────
# ngrok 대시보드(Universal Gateway > Domains)에서 발급한 고정 도메인. 구글 redirect URI 를 미리 등록해야 하므로 고정 도메인 권장
NGROK_DOMAIN=my-family.ngrok-free.app

# ── 구글 포토 (Google Cloud Console > OAuth 클라이언트 ID: 웹 애플리케이션) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# refresh token 암호화 키: openssl rand -base64 32
GOOGLE_TOKEN_KEY=

# ── 보안 ────────────────────────────────────────────
# 내 가족을 만든 뒤에는 false 로 바꿔 외부인이 새 가족을 만들지 못하게 하세요(초대 코드 가입만 허용)
ALLOW_NEW_FAMILY=true

# ── 월드컵 인터넷 이미지 검색 (선택) ─────────────────
# 비워 두면 키 없이 쓰는 Openverse 를 사용. Pexels 무료 키(https://www.pexels.com/api/)가 있으면 고화질·한글 검색
PEXELS_API_KEY=

# ── Docker / Cloudflare Tunnel 배포 (docker-compose.yml) ─────
POSTGRES_PASSWORD=change-me-long-random
# 외부에서 접속하는 공개 주소(https://…). 구글 redirect URI 와 같은 값이어야 함
APP_BASE_URL=https://album.example.com
# Cloudflare Zero Trust > Networks > Tunnels 에서 만든 터널의 토큰 (profile: named)
CLOUDFLARE_TUNNEL_TOKEN=
