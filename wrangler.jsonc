{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "family-album",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/meet/*",\n      "/api/*",
      "/google/callback"
    ]
  }
}
